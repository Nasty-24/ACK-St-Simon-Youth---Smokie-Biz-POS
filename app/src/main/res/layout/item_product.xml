<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="@dimen/tile_min_height"
    android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="18dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:layout_margin="5dp" android:background="@drawable/tile_spine_ember"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tileName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        style="@style/AppText.SubHeading" android:textColor="@color/ink" />
    <TextView android:id="@+id/tilePrice" android:layout_width="wrap_content" android:layout_height="wrap_content"
        style="@style/AppText.Muted" />
</LinearLayout>
