<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp">
        <Button android:id="@+id/newSaleButton" style="@style/AppButton.Outline" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="← New sale" android:layout_marginEnd="6dp" />
        <Button android:id="@+id/printButton" style="@style/AppButton.Primary" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Print receipt" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="300dp" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:background="@color/white" android:padding="16dp" android:orientation="vertical">

        <TextView android:id="@+id/receiptBusiness" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textStyle="bold" android:textSize="14sp" android:textAlignment="center" />
        <TextView android:id="@+id/receiptTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="12sp" android:textAlignment="center" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/receiptMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" />
        <TextView android:id="@+id/receiptCustomer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" android:layout_marginBottom="6dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#999999" android:layout_marginBottom="4dp" />

        <LinearLayout android:id="@+id/receiptItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#999999" android:layout_marginTop="4dp" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/receiptTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textStyle="bold" android:textSize="13sp" android:textAlignment="viewEnd" />
        <TextView android:id="@+id/receiptPaid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" />
        <TextView android:id="@+id/receiptBalance" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" android:textColor="@color/brick" android:visibility="gone" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#999999" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/receiptFooter" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" android:textAlignment="center" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
