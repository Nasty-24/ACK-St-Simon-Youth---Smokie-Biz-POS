<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Today at the kiosk" style="@style/AppText.Heading" android:layout_marginBottom="10dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/bg_card" android:padding="12dp" android:orientation="vertical" android:layout_marginEnd="6dp">
            <TextView style="@style/AppText.Muted" android:text="SALES MADE" android:textSize="11sp" />
            <TextView android:id="@+id/statSalesCount" style="@style/AppText.Heading" android:text="0" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/bg_card" android:padding="12dp" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView style="@style/AppText.Muted" android:text="REVENUE" android:textSize="11sp" />
            <TextView android:id="@+id/statRevenue" style="@style/AppText.Heading" android:text="KSh 0.00" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/bg_card" android:padding="12dp" android:orientation="vertical" android:layout_marginEnd="6dp">
            <TextView style="@style/AppText.Muted" android:text="PROFIT TODAY" android:textSize="11sp" />
            <TextView android:id="@+id/statProfit" style="@style/AppText.Heading" android:textColor="@color/leaf" android:text="KSh 0.00" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/bg_card" android:padding="12dp" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView style="@style/AppText.Muted" android:text="OWED BY CUSTOMERS" android:textSize="11sp" />
            <TextView android:id="@+id/statOwed" style="@style/AppText.Heading" android:textColor="@color/brick" android:text="KSh 0.00" />
        </LinearLayout>
    </LinearLayout>

    <Button android:id="@+id/newSaleButton" style="@style/AppButton.Primary"
        android:layout_width="match_parent" android:layout_height="54dp" android:text="+ New sale" android:layout_marginBottom="18dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Recent activity" style="@style/AppText.SubHeading" android:layout_marginBottom="6dp" />

    <LinearLayout android:id="@+id/recentList" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_card" android:padding="4dp" android:divider="?android:dividerHorizontal" android:showDividers="middle" />

</LinearLayout>
