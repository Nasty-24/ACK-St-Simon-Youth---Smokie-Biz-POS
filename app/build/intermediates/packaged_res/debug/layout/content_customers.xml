<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Customer book" style="@style/AppText.Heading" />
    <TextView android:id="@+id/totalOwedText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        style="@style/AppText.Muted" android:layout_marginBottom="10dp" />

    <EditText android:id="@+id/searchField" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Search by name or phone…" android:background="@drawable/bg_input" android:padding="10dp"
        android:imeOptions="actionSearch" android:singleLine="true" android:layout_marginBottom="10dp" />

    <LinearLayout android:id="@+id/customerListHost" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_card" android:padding="6dp"
        android:divider="?android:dividerHorizontal" android:showDividers="middle" android:layout_marginBottom="18dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Add a customer" style="@style/AppText.SubHeading" android:layout_marginBottom="6dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp">
        <EditText android:id="@+id/newCustName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Full name" android:background="@drawable/bg_input" android:padding="10dp" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/newCustPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Phone (optional)" android:inputType="phone" android:background="@drawable/bg_input" android:padding="10dp" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/newCustLimit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Credit limit (optional)" android:text="0" android:inputType="numberDecimal"
            android:background="@drawable/bg_input" android:padding="10dp" android:layout_marginBottom="10dp" />
        <Button android:id="@+id/addCustomerButton" style="@style/AppButton.Primary"
            android:layout_width="match_parent" android:layout_height="50dp" android:text="Add customer" />
    </LinearLayout>
</LinearLayout>
